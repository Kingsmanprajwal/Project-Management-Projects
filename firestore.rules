rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(ws) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(ws)).data.memberIds;
    }

    // Each user can only read/write their own profile.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /workspaces/{ws} {
      // The workspace id is the (unguessable) invite code, so any signed-in
      // user who has the code may look it up in order to join.
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        // Joining: a user may only add themselves to the member list.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds)
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Notes, docs, tasks, people: only team members.
      match /{collection}/{id} {
        allow read, write: if isMember(ws);
      }
    }
  }
}
