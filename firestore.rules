rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(ws) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(ws)).data.memberIds;
    }

    // Each user can only read/write their own profile.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Saved Content: private to its owner. Nobody else (not even teammates) can read it.
      match /savedItems/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSavedItem(request.resource.data);
      }
      match /collections/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCollection(request.resource.data);
      }
      match /fileChunks/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.bytes is bytes
          && request.resource.data.bytes.size() <= 768000;
      }
    }

    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validSavedItem(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.userId == request.auth.uid
        && (!('originalUrl' in d) || (d.originalUrl is string && d.originalUrl.size() <= 2048))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 20000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 30))
        && (!('collectionIds' in d) || (d.collectionIds is list && d.collectionIds.size() <= 100));
    }
    function validCollection(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.userId == request.auth.uid;
    }

    match /workspaces/{ws} {
      // The workspace id is the (unguessable) invite code, so any signed-in
      // user who has the code may look it up in order to join.
      allow get: if signedIn();
      // Team access: a user whose verified email is on the team's list can find the team.
      allow list: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.allowedEmails;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        // Joining: a user may only add themselves to the member list.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds)
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Notes, docs, tasks, people: only team members.
      match /{collection}/{id} {
        allow read, write: if isMember(ws);
      }
    }
  }
}
