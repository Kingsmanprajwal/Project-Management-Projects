{
  "name": "TaskNest – Notes, Docs & Deadlines",
  "short_name": "TaskNest",
  "description": "Notes, document storage, idea to-do lists, deadline tracker and team task assigner.",
  "id": "./",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f7f5",
  "theme_color": "#2f6fed",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "New note", "url": "./#notes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Deadline tracker", "url": "./#tracker", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Assign a task", "url": "./#assign", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
